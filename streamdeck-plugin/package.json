{
  "name": "com.soundboardlite.streamdeck",
  "version": "1.1.0",
  "private": true,
  "description": "Stream Deck plugin for Soundboard Lite — trigger clips, stop, and panic-stop from physical Stream Deck keys via Soundboard Lite's embedded local API.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "esbuild src/plugin.ts --bundle --platform=node --format=esm --target=node20 --outfile=com.soundboardlite.streamdeck.sdPlugin/bin/plugin.js --sourcemap --banner:js=\"import{createRequire as __cr}from 'module';const require=__cr(import.meta.url);\"",
    "build": "npm run typecheck && npm run bundle",
    "watch": "npm run bundle -- --watch",
    "pack": "streamdeck pack com.soundboardlite.streamdeck.sdPlugin -f"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.3",
    "@elgato/utils": "^0.6.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.3",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
