<ui:FluentWindow
    x:Class="SoundboardLite.App.Views.ClipEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:SoundboardLite.App.Controls"
    Title="Edit clip"
    Width="560"
    Height="700"
    MinWidth="480"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Name, StringFormat='Edit - {0}'}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Text="Name" VerticalAlignment="Center" Width="60" />
            <TextBox Width="300" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Drag the yellow handles to trim the clip"
                   Margin="0,8,0,4"
                   Opacity="0.7" />

        <controls:WaveformControl Grid.Row="3"
                                   Peaks="{Binding Peaks}"
                                   TotalDurationMs="{Binding OriginalDurationMs}"
                                   TrimStartMs="{Binding TrimStartMs, Mode=TwoWay}"
                                   TrimEndMs="{Binding TrimEndMs, Mode=TwoWay}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <ui:Button Content="Preview" Command="{Binding PreviewCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Play24" />
                </ui:Button.Icon>
            </ui:Button>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="OrangeRed"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,16,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pitch (semitones)" VerticalAlignment="Center" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="-12" Maximum="12"
                    Value="{Binding PitchSemitones}" TickFrequency="1" Margin="0,4" />
            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding PitchSemitones, StringFormat={}{0:0.0}}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Gain (dB)" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="-24" Maximum="24"
                    Value="{Binding GainDb}" Margin="0,4" />
            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding GainDb, StringFormat={}{0:0.0}}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Fade in (ms)" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="2000"
                    Value="{Binding FadeInMs}" Margin="0,4" />
            <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding FadeInMs, StringFormat={}{0:0}}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Fade out (ms)" VerticalAlignment="Center" />
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="2000"
                    Value="{Binding FadeOutMs}" Margin="0,4" />
            <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding FadeOutMs, StringFormat={}{0:0}}" />
        </Grid>

        <StackPanel Grid.Row="6" Margin="0,16,0,0">
            <CheckBox Content="Enable push-to-talk for this clip" IsChecked="{Binding PttEnabled}" />

            <Grid Margin="0,8,0,0" IsEnabled="{Binding PttEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Key (blank = global default)" VerticalAlignment="Center" />
                <controls:KeyCaptureBox Grid.Row="0" Grid.Column="1"
                                         VirtualKeyCode="{Binding PttKeyOverride}"
                                         Width="200" HorizontalAlignment="Left" Margin="0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Begin delay override (ms)" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4"
                         Text="{Binding PttBeginDelayMsOverride, TargetNullValue=''}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="End delay override (ms)" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4"
                         Text="{Binding PttEndDelayMsOverride, TargetNullValue=''}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
