<ui:FluentWindow
    x:Class="SoundboardLite.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SoundboardLite.App.ViewModels"
    Title="Soundboard Lite"
    Width="1040"
    Height="680"
    MinWidth="720"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Soundboard Lite" />

        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Boards sidebar -->
            <DockPanel Grid.Column="0" Margin="0,0,16,0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Boards" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="170"
                                 Text="{Binding NewBoardName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="New board name" />
                        <ui:Button Margin="6,0,0,0" Command="{Binding CreateBoardCommand}" Appearance="Primary">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>

                <ListBox ItemsSource="{Binding Boards}"
                         SelectedItem="{Binding SelectedBoard}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BoardItemViewModel}">
                            <Grid>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename" Command="{Binding BeginRenameCommand}" />
                                        <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <TextBlock Text="{Binding Name}" Padding="4,6" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="BoardRenameTextBox_KeyDown"
                                         LostFocus="BoardRenameTextBox_LostFocus"
                                         IsVisibleChanged="BoardRenameTextBox_IsVisibleChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Clips for the selected board -->
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                    <ui:Button Content="Import clip..." Command="{Binding ImportClipCommand}" Appearance="Primary">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <TextBlock Text="Output device:" VerticalAlignment="Center" Margin="20,0,8,0" />
                    <ComboBox Width="280"
                              ItemsSource="{Binding OutputDevices}"
                              SelectedItem="{Binding SelectedOutputDevice}"
                              DisplayMemberPath="Name" />

                    <ui:Button Margin="20,0,0,0" Content="Settings" Command="{Binding OpenSettingsCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedBoard.Clips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ClipItemViewModel}">
                                <Border Margin="0,0,10,10" Width="200" Padding="12"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="MusicNote224" />
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="Medium"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <ui:Button Appearance="Primary" ToolTip="Play" Command="{Binding PlayCommand}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Play24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button Margin="4,0,0,0" ToolTip="Stop" Command="{Binding StopCommand}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Stop24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button Margin="4,0,0,0" ToolTip="Edit" Command="{Binding EditCommand}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Edit24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="OrangeRed"
                   Margin="16,0,16,10" />
    </Grid>
</ui:FluentWindow>
