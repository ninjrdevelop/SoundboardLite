<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SoundboardLite.Core\SoundboardLite.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <!-- Plain SoundTouch.Net, not the .NAudioSupport bridge package — that one transitively pulls the
         legacy monolithic NAudio package, which conflicts (CS0433) with NAudio.Core/NAudio.Wasapi's
         duplicate WaveFormat/ISampleProvider types. SoundTouchProcessor.PutSamples/ReceiveSamples
         already work directly with Span<float>, so no bridge is needed. -->
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SoundboardLite.Audio.Tests" />
  </ItemGroup>

</Project>
